# Copy this file to .sidera/r5-3.local.env, replace every <set-locally>
# value, create the referenced private directories, and chmod 600 the copy.
# This example is documentation only and is not a runnable env file as-is.

# Control Plane runtime and its isolated test database.
SIDERA_DATABASE_URL=postgresql+psycopg://sidera@127.0.0.1:55432/sidera_r53_runtime
SIDERA_R5_3_TEST_DATABASE_URL=postgresql+psycopg://sidera@127.0.0.1:55432/sidera_r53_cp_test

# Knowledge Service runtime and its isolated test database.
SIDERA_KNOWLEDGE_DATABASE_URL=postgresql+psycopg://sidera@127.0.0.1:55432/sidera_r53_knowledge_runtime
SIDERA_R5_3_KNOWLEDGE_TEST_DATABASE_URL=postgresql+psycopg://sidera@127.0.0.1:55432/sidera_r53_knowledge_test

# Workspace/planning identity.
SIDERA_WORKSPACE_ID=20000000-0000-0000-0000-000000000001
# Keep deterministic release evidence in a workspace separate from live work.
SIDERA_R5_3_GATE_WORKSPACE_ID=20000000-0000-0000-0000-000000000002
SIDERA_PLANNING_PROFILE_ID=10000000-0000-0000-0000-000000000001
SIDERA_PLANNING_PROFILE_VERSION=1

# Local HTTP origins. Keep these on loopback for this release.
SIDERA_CONTROL_PLANE_URL=http://127.0.0.1:8000
SIDERA_KNOWLEDGE_BASE_URL=http://127.0.0.1:8020
SIDERA_MAIN_AGENT_GATEWAY_URL=http://127.0.0.1:8010
SIDERA_WEB_URL=http://127.0.0.1:4173

# Capability tokens. Never commit the replaced values.
SIDERA_KNOWLEDGE_LOCAL_OWNER_TOKEN=<set-locally>
SIDERA_KNOWLEDGE_CONTROL_PLANE_TOKEN=<set-locally>
SIDERA_KNOWLEDGE_MAIN_AGENT_TOKEN=<set-locally>
SIDERA_AKASHIC_WORKSPACE_TOKEN=<set-locally>

# Context cutover and bounded terminal Candidate spool.
SIDERA_CONTEXT_PACKAGE_CUTOVER_AT=2026-08-27T00:00:00+08:00
SIDERA_KNOWLEDGE_CANDIDATE_SPOOL_DIR=/absolute/path/to/repo/.sidera/runtime/candidate-spool

# Existing external Akashic host identity.
SIDERA_AKASHIC_ENDPOINT=/absolute/path/to/akashic/control.sock
SIDERA_AKASHIC_WORKSPACE=/absolute/path/to/akashic/workspace
SIDERA_AKASHIC_CONFIG=/absolute/path/to/akashic/config.toml

# OpenCode planner identity. Provider credentials stay in the provider config,
# not in this env file; this value is only the executable/model selection.
SIDERA_OPENCODE_EXECUTABLE=/absolute/path/to/opencode
SIDERA_OPENCODE_EXPECTED_VERSION=1.18.19
SIDERA_OPENCODE_MODEL=opencode-go/mimo-v2.5
SIDERA_PLANNING_OPENCODE_REQUEST_TIMEOUT_SECONDS=300
