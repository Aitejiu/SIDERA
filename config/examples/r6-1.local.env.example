# Copy to .sidera/r6-1.local.env, replace every placeholder locally, and chmod 600.
# The R6.1 preflight parses this file as KEY=VALUE; it is never sourced.
SIDERA_DATABASE_URL=postgresql+psycopg://sidera:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:55432/sidera_r61_runtime
SIDERA_R6_1_TEST_DATABASE_URL=postgresql+psycopg://sidera:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:55432/sidera_r61_test
SIDERA_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
SIDERA_CONTROL_PLANE_URL=http://127.0.0.1:8100
SIDERA_MAIN_AGENT_GATEWAY_URL=http://127.0.0.1:8110
SIDERA_WEB_URL=http://127.0.0.1:4173
SIDERA_AKASHIC_ENDPOINT=/absolute/path/to/akashic/control.sock
SIDERA_AKASHIC_WORKSPACE_TOKEN=REPLACE_WITH_LOCAL_AKASHIC_TOKEN
SIDERA_AKASHIC_WORKSPACE=/absolute/path/to/akashic-workspace
SIDERA_AKASHIC_CONFIG=/absolute/path/to/akashic-config.toml
SIDERA_OPENCODE_EXECUTABLE=/opt/homebrew/bin/opencode
SIDERA_OPENCODE_EXPECTED_VERSION=1.18.19
SIDERA_OPENCODE_MODEL=opencode-go/mimo-v2.5
SIDERA_PLANNING_PROFILE_ID=00000000-0000-4000-8000-000000000002
SIDERA_PLANNING_PROFILE_VERSION=1
