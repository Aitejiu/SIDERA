# Copy to .sidera/r5-2.local.env and chmod 600 before running the local stack.
# Values in this file are placeholders; do not put credentials in the repository.

# Control Plane and planning identity
SIDERA_DATABASE_URL=postgresql+psycopg://sidera@127.0.0.1:55432/sidera_test
SIDERA_WORKSPACE_ID=20000000-0000-0000-0000-000000000001
SIDERA_PLANNING_PROFILE_ID=10000000-0000-0000-0000-000000000001
SIDERA_PLANNING_PROFILE_VERSION=1

# Local SIDERA services
SIDERA_CONTROL_PLANE_URL=http://127.0.0.1:8000
SIDERA_WEB_URL=http://127.0.0.1:4174
SIDERA_MAIN_AGENT_GATEWAY_URL=http://127.0.0.1:8010

# External Akashic app-server; SIDERA does not manage this process.
SIDERA_AKASHIC_ENDPOINT=/absolute/path/to/akashic/control.sock
SIDERA_AKASHIC_WORKSPACE_TOKEN=replace-me
SIDERA_AKASHIC_WORKSPACE=/absolute/path/to/akashic/workspace
SIDERA_AKASHIC_CONFIG=/absolute/path/to/akashic/config.toml

# Planner executable used by the SIDERA planning worker.
SIDERA_OPENCODE_EXECUTABLE=/absolute/path/to/opencode
SIDERA_OPENCODE_EXPECTED_VERSION=1.18.19
SIDERA_OPENCODE_MODEL=deepseek/deepseek-v4-flash
